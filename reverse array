import java.util.*;
class Main{
    public static void main(String args[]){
        int[] arr={1,4,3,5,9,8};
        int n=arr.length;
        int start=0;
        int end=n-1;
        while(start<end){
            int temp=arr[start];
            arr[start]=arr[end];
            arr[end]=temp;
            
            start++;
            end--;
        }
        System.out.print(Arrays.toString(arr));
}
}
