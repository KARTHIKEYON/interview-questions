import java.util.*;
class Main{
    public static void main(String[] args){
        int arr[]={4,3,5,7,1,8,9};
        int size=arr.length;
        int shift=4;
        shift=shift%size;
        while(shift>0){
            int last=arr[size-1];
            for(int i=size-1;i>0;i--){
                arr[i]=arr[i-1];
            }
            arr[0]=last;
            shift--;
        }
        for(int i:arr){
            System.out.print(i+" ");
        }
    }
}

output:
7 1 8 9 4 3 5
